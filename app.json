{
  "expo": {
    "name": "Chateau Neuf",
    "slug": "cnapp",
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#E5E2D7"
    },
    "scheme": "no-neuf-chateau",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "no.neuf.chateau",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "no.neuf.chateau",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#CD96AB"
      },
      "permissions": ["NOTIFICATIONS"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#E5E2D7"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "908b7664-3796-4d49-b075-2847b0804c02"
      }
    },
    "owner": "neuf"
  }
}
